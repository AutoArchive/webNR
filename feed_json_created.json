{"version": "https://jsonfeed.org/version/1.1", "title": "WebNR Documentation", "home_page_url": "https://www.webnovel.win/", "feed_url": "https://www.webnovel.win/feed_json_created.json", "description": "User and developer documentation for the private, local-first WebNR TXT reader", "icon": null, "authors": [{"name": "AutoArchive contributors"}], "language": "en", "items": [{"id": "https://www.webnovel.win/blog/2026/08/22/korean-web-novel-discovery/", "url": "https://www.webnovel.win/blog/2026/08/22/korean-web-novel-discovery/", "title": "2026 \u97e9\u56fd\u7f51\u6587\u600e\u4e48\u627e\uff1f\u4ece\u97e9\u6587\u539f\u7ad9\u5230\u82f1\u8bed\u6b63\u5f0f\u7248\u7684\u5b8c\u6574\u8def\u7ebf\u56fe", "content_html": "\u9762\u5411\u4e2d\u6587\u8bfb\u8005\u7684\u97e9\u56fd Web \u5c0f\u8bf4\u53d1\u73b0\u8def\u7ebf\uff1a\u97e9\u6587\u539f\u7ad9\u3001\u7248\u672c\u5173\u7cfb\u3001\u6539\u7f16\u53cd\u67e5\u3001\u82f1\u8bed\u6b63\u5f0f\u7248\u4e0e\u7ffb\u8bd1\u7d22\u5f15\uff0c\u4ee5\u53ca\u4e00\u5957\u53ef\u7ef4\u62a4\u7684\u4f5c\u54c1\u8eab\u4efd\u56fe\u65b9\u6cd5\u3002", "image": null, "date_modified": "2026-08-22T17:38:32+00:00", "date_published": "2026-08-22T00:00:00+00:00", "authors": [], "tags": null}, {"id": "https://www.webnovel.win/blog/2026/08/20/japanese-web-novel-discovery/", "url": "https://www.webnovel.win/blog/2026/08/20/japanese-web-novel-discovery/", "title": "2026 \u65e5\u672c\u7f51\u6587\u53bb\u54ea\u91cc\u627e\uff1f\u4ece\u300c\u5c0f\u8aac\u5bb6\u306b\u306a\u308d\u3046\u300d\u5230\u7ffb\u8bd1\u7d22\u5f15\u7684\u5b8c\u6574\u8def\u7ebf\u56fe", "content_html": "\u9762\u5411\u4e2d\u6587\u8bfb\u8005\u7684\u65e5\u672c Web \u5c0f\u8bf4\u53d1\u73b0\u8def\u7ebf\uff1a\u539f\u59cb\u8fde\u8f7d\u5e73\u53f0\u3001\u8bfb\u8005\u793e\u533a\u3001\u82f1\u6587\u7ffb\u8bd1\u7d22\u5f15\u3001\u5b98\u65b9\u6388\u6743\u51fa\u7248\u4e0e\u9752\u7a7a\u6587\u5e93\uff0c\u4ee5\u53ca\u4e00\u5957\u53ef\u590d\u7528\u7684\u4f5c\u54c1\u8eab\u4efd\u6838\u9a8c\u65b9\u6cd5\u3002", "image": null, 